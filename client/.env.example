* {
  box-sizing: border-box;
}

html, body, #root {
  margin: 0;
  min-height: 100%;
  min-width: 0;
  font-family: Arial, sans-serif;
  background: #f2f5f1;
  color: #20312e;
}

body {
  min-height: 100vh;
}

.site-nav {
  background-color: rgb(23, 13, 110);
  width: 100%;
  border-bottom: solid 1px rgb(85, 85, 92);
  display: flex;
  align-items: center;
  justify-content: space-between;
  flex-wrap: wrap;
  gap: 10px 24px;
  padding: 10px 20px;
  position: sticky;
  top: 0;
  z-index: 1000;
}

.site-nav a {
  text-align: center;
  text-decoration: none;
  color: white;
  padding: 8px 4px;
}

.brand-lockup {
  display: flex;
  flex: 0 1 auto;
  align-items: center;
  justify-content: flex-start;
  gap: 12px;
}

.site-brand {
  margin: 0;
  color: #fff;
  text-align: center;
  font-size: 1.15rem;
}

.site-logo {
  display: block;
  width: 64px;
  height: 64px;
  flex: 0 0 64px;
  border-radius: 50%;
  object-fit: contain;
  background: #000;
}

.site-links {
  display: flex;
  align-items: center;
  justify-content: flex-end;
  flex-wrap: wrap;
  gap: 4px 20px;
}

.home-section {
  height: clamp(320px, 65vh, 500px);
  width: 100%;
  background-color: rgb(61, 193, 202);
  padding: 0;
}

.home {
  position: relative;
  width: 100%;
  height: 100%;
  overflow: hidden;
}

.home h2 {
  position: absolute;
  top: 50%;
  left: 50%;
  width: 100%;
  margin: 0;
  color: white;
  text-align: center;
  transform: translate(-50%, -50%);
  z-index: 1;
}

.home-message {
  position: absolute;
  top: 65%;
  left: 20px;
  max-width: calc(100% - 40px);
  color: white;
  font-size: 20px;
  z-index: 1;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
  animation: slide-message-right 8s ease-in-out forwards;
}

@keyframes slide-message-right {
  0%, 65% {
    left: 20px;
    transform: translateX(0);
  }
  100% {
    left: 100%;
    transform: translateX(-100%);
  }
}

.photo-window {
  position: absolute;
  inset: 0;
  overflow: hidden;
}

.photo-track {
  display: flex;
  width: 100%;
  height: 100%;
  transition: transform 1s ease;
}

.photo-track img,
.photo-track video {
  display: block;
  flex: 0 0 100%;
  height: 100%;
  width: 100%;
  object-fit: cover;
}

.photo-track video {
  object-fit: contain;
  background: #111;
}

.media-error {
  position: absolute;
  z-index: 2;
  right: 12px;
  bottom: 8px;
  max-width: calc(100% - 24px);
  margin: 0;
  padding: 8px 12px;
  color: #8b1e16;
  background: #fff;
  white-space: normal;
}

footer {
  background-color: rgb(3, 3, 3);
  width: 100%;
  height: 60px;
  display: flex;
  align-items: center;
  justify-content: center;
}

footer p {
  margin: 0;
  color: white;
  text-align: center;
  padding: 15px;
}

@media (max-width: 1100px) {
  .site-nav {
    height: auto;
    justify-content: flex-start;
    padding: 10px 14px;
  }

  .site-links {
    justify-content: flex-start;
    width: 100%;
    gap: 4px 16px;
  }

  .home h2 {
    padding: 0 14px;
    font-size: clamp(1.25rem, 5vw, 2rem);
  }

  .home-message {
    top: 68%;
    left: 12px;
    max-width: calc(100% - 24px);
    font-size: clamp(16px, 4vw, 20px);
  }
}

@media (max-width: 380px) {
  .site-nav {
    gap: 4px 10px;
    padding-inline: 8px;
  }

  .site-links a {
    font-size: 0.9rem;
  }

  .home-section {
    height: 320px;
  }
}
