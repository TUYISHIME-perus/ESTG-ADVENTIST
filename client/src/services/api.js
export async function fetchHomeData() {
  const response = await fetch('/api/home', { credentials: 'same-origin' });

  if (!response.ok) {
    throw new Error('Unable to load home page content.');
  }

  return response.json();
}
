import { useEffect, useRef, useState } from 'react';
import SiteNav from '../components/SiteNav';
import { fetchHomeData } from '../services/api';

export default function HomePage() {
  const [homeMessages, setHomeMessages] = useState([]);
  const [photos, setPhotos] = useState([]);
  const [hasVideo, setHasVideo] = useState(false);
  const [error, setError] = useState('');
  const [messageIndex, setMessageIndex] = useState(0);
  const [slideIndex, setSlideIndex] = useState(0);
  const trackRef = useRef(null);

  useEffect(() => {
    let isActive = true;

    async function load() {
      try {
        const data = await fetchHomeData();
        if (!isActive) return;
        setHomeMessages((Array.isArray(data.homeMessages) ? data.homeMessages : []).filter(Boolean));
        setPhotos((Array.isArray(data.homePhotos) ? data.homePhotos : []).filter((photo) => typeof photo === 'string' && photo.startsWith('data:image/')));
        setHasVideo(Boolean(data.hasVideo));
      } catch (loadError) {
        if (!isActive) return;
        setError(loadError.message || 'Unable to load home page content.');
      }
    }

    load();

    return () => {
      isActive = false;
    };
  }, []);

  useEffect(() => {
    if (homeMessages.length <= 1) return undefined;
    const timer = window.setTimeout(() => {
      setMessageIndex((current) => (current + 1) % homeMessages.length);
    }, 8000);
    return () => window.clearTimeout(timer);
  }, [homeMessages, messageIndex]);

  useEffect(() => {
    if (photos.length <= 1 && !hasVideo) return undefined;

    const interval = window.setInterval(() => {
      setSlideIndex((current) => current + 1);
    }, 10000);

    return () => window.clearInterval(interval);
  }, [photos.length, hasVideo]);

  useEffect(() => {
    if (!trackRef.current) return;

    const isVideoSlide = hasVideo && slideIndex >= photos.length;
    const shouldReset = !hasVideo && slideIndex >= photos.length;

    if (shouldReset) {
      trackRef.current.style.transition = 'none';
      trackRef.current.style.transform = 'translateX(0)';
      const reset = window.setTimeout(() => {
        setSlideIndex(0);
        requestAnimationFrame(() => {
          if (trackRef.current) {
            trackRef.current.style.transition = '';
          }
        });
      }, 1000);
      return () => window.clearTimeout(reset);
    }

    if (isVideoSlide) {
      const reset = window.setTimeout(() => {
        setSlideIndex(0);
      }, 1000);
      return () => window.clearTimeout(reset);
    }

    trackRef.current.style.transform = `translateX(-${slideIndex * 100}%)`;
  }, [photos.length, hasVideo, slideIndex]);

  const visibleSlideCount = photos.length + (hasVideo ? 1 : 0);

  return (
    <>
      <SiteNav />
      <section className="home-section">
        <div className="home">
          <h2>Welcome to ESTG SDA church program</h2>
          {homeMessages.length > 0 && (
            <p id="home-message" className="home-message" aria-live="polite">
              {homeMessages[messageIndex]}
            </p>
          )}
          {error && <p className="media-error">{error}</p>}

          {visibleSlideCount > 0 && (
            <div className="photo-window">
              <div ref={trackRef} className="photo-track">
                {photos.map((photo, index) => (
                  <img key={`${photo}-${index}`} src={photo} alt={`Home photo ${index + 1}`} />
                ))}
                {hasVideo && (
                  <video
                    src="/api/media/video"
                    autoPlay
                    muted
                    playsInline
                    controls
                    preload="auto"
                    aria-label="Home page video"
                    onError={() => setError('The saved home video could not be played in this browser.')}
                  />
                )}
              </div>
            </div>
          )}
        </div>
      </section>
      <footer>
        <p>all right reserved@2026</p>
      </footer>
    </>
  );
}
