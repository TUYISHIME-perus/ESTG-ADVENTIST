{
  "name": "estg-sda-church-programs",
  "version": "1.0.0",
  "private": true,
  "description": "ESTG SDA church programs website with a React frontend and the existing Node.js backend.",
  "type": "commonjs",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "concurrently \"npm run dev:server\" \"npm run dev:client\"",
    "dev:server": "node --env-file=.env server.js",
    "dev:client": "npm --prefix client run dev -- --host 0.0.0.0",
    "build": "npm --prefix client run build",
    "preview": "npm --prefix client run preview -- --host 0.0.0.0",
    "test": "node --test"
  },
  "engines": {
    "node": ">=22.5.0"
  },
  "devDependencies": {
    "concurrently": "^9.2.0"
  }
}
